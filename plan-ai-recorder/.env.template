# Backend API URL (Default local is http://localhost:8080)
VITE_PLAN_AI_API_URL=http://localhost:8080

# Frontend Web URL (Default local is http://localhost:3000)
VITE_PLAN_AI_WEB_URL=http://localhost:3000

# App Protocol for deep linking (e.g. blueberrybytes-recorder, housegroup-recorder)
VITE_APP_PROTOCOL=blueberrybytes-recorder

# Debug/development flags
VITE_LOGIN_BUG=false

# Firebase Configuration (for file uploads)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Sentry DSN (for error tracking)
VITE_SENTRY_DSN=

# Apple Developer Credentials for macOS Notarization
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=8NN84K7QKJ

# Set to 1 only for a local macOS build that will not be shipped. Without it a
# build with missing Apple credentials fails (see scripts/notarize.js).
SKIP_NOTARIZE=

# Windows code signing (see electron-builder.config.js). Either a .pfx file:
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
# or Azure Trusted Signing (build on Windows), with AZURE_TENANT_ID,
# AZURE_CLIENT_ID and AZURE_CLIENT_SECRET for the service principal:
AZURE_SIGN_ENDPOINT=
AZURE_SIGN_ACCOUNT=
AZURE_SIGN_PROFILE=
# Azure only (a .pfx gives it itself). Must match the certificate's subject
# CN exactly, e.g. "BLUEBERRYBYTES SERVICES FZCO".
WIN_PUBLISHER_NAME=
