+            RCTLogInfo(@"[RNLiveAudioStream] audio session interruption ended");
+            [self resumeCapture];
+        }
+    });
+}
+
+- (void)handleMediaServicesReset:(NSNotification *)notification {
+    dispatch_async(_workQueue, ^{
+        RCTLogWarn(@"[RNLiveAudioStream] media services were reset");
+        // The old queue belongs to the dead media server. Dispose it without a
+        // stop call and never touch its buffers again.
+        self->_queueStarted = NO;
+        [self disposeQueueStoppingFirst:NO];
+        if (!self->_recordState.mIsRunning) {
+            return;
+        }
+
+        NSString *failure = [self configureSession];
+        if (failure == nil) {
+            failure = [self buildQueue];
+        }
+        if (failure == nil) {
+            OSStatus status = AudioQueueStart(self->_recordState.mQueue, NULL);
+            if (status != noErr) {
+                failure = [NSString stringWithFormat:@"AudioQueueStart failed after a media services reset. OSStatus %d", (int) status];
+            }
+        }
+        if (failure != nil) {
+            [self failWithMessage:failure];
+            return;
+        }
+        self->_queueStarted = YES;
+        [self emit:kEventResumed body:@{}];
+    });
+}
+
+#pragma mark - Teardown
+
+- (void)invalidate {
+    RCTLogInfo(@"[RNLiveAudioStream] invalidate");
+    [self removeSessionObservers];
+    _recordState.mIsRunning = false;
+    _queueStarted = NO;
+    [self disposeQueueStoppingFirst:YES];
+    [super invalidate];
 }
 
 - (void)dealloc {
     RCTLogInfo(@"[RNLiveAudioStream] dealloc");
-    AudioQueueDispose(_recordState.mQueue, true);
+    [self removeSessionObservers];
+    _recordState.mIsRunning = false;
+    [self disposeQueueStoppingFirst:YES];
+    _recordState.mSelf = nil;
 }
 
 @end
+
+static void HandleInputBuffer(void *inUserData,
+                              AudioQueueRef inAQ,
+                              AudioQueueBufferRef inBuffer,
+                              const AudioTimeStamp *inStartTime,
+                              UInt32 inNumPackets,
+                              const AudioStreamPacketDescription *inPacketDesc) {
+    AQRecordState* pRecordState = (AQRecordState *)inUserData;
+
+    if (!pRecordState->mIsRunning) {
+        return;
+    }
+
+    short *samples = (short *) inBuffer->mAudioData;
+    long nsamples = inBuffer->mAudioDataByteSize;
+    NSData *data = [NSData dataWithBytes:samples length:nsamples];
+    NSString *str = [data base64EncodedStringWithOptions:0];
+    if (pRecordState->mSelf != nil) {
+        [pRecordState->mSelf sendEventWithName:@"data" body:str];
+    }
+
+    // Give the buffer back to the queue that delivered it. After a rebuild
+    // mQueue already points to the new queue.
+    AudioQueueEnqueueBuffer(inAQ, inBuffer, 0, NULL);
+}
