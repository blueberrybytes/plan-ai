rules_version = '2';

// The backend reads and writes the bucket with the Admin SDK, which skips
// these rules. They only govern what the apps do with the Firebase client
// SDK, and the apps upload three things: the avatar, a brand theme logo and
// an image pasted into a slide. Everything else is closed. Recordings,
// context files, chat attachments and voice profiles are private and only
// ever read through signed links the backend creates.
service firebase.storage {
  match /b/{bucket}/o {
    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile picture, shown next to the user's name.
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && isImageUnder(5 * 1024 * 1024);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Brand theme logo, shown on shared documents and decks. SVG is allowed
    // here only: it is served from the storage domain, not the app's.
    match /themes/{userId}/logos/{imageId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && (isImageUnder(5 * 1024 * 1024)
          || (request.resource.size < 1024 * 1024
            && request.resource.contentType == 'image/svg+xml'));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Image a member pastes into a slide. The file name is random; the app
    // reads it back once to get its download link.
    match /presentations/{presentationId}/manual_edits/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isImageUnder(10 * 1024 * 1024);
    }
  }
}
