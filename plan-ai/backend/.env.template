# ─── Telegram "Berry" sales bot ───────────────────────────────────────────────
# Token from @BotFather. Without it the webhook answers but sends nothing.
TELEGRAM_BOT_TOKEN=""

# Secret registered with setWebhook(secret_token=...). Telegram echoes it back in
# the X-Telegram-Bot-Api-Secret-Token header; it is the ONLY auth on the public
# webhook, so generate a long random value and never reuse it.
TELEGRAM_WEBHOOK_SECRET=""

# Workspace whose BYOK keys pay for prospect generations (marketing spend, not
# customer spend), and the service user that owns the generated docs.
TELEGRAM_WORKSPACE_ID=""
TELEGRAM_SERVICE_USER_ID=""

# Proposals allowed per chat per 24h. Guards our OpenRouter credits.
TELEGRAM_RATE_LIMIT="5"

# Messages allowed per chat per 24h, generated or not. Every message costs a
# cheap triage call, so chatter needs its own ceiling.
TELEGRAM_MESSAGE_LIMIT="30"

# Deepgram language for voice notes. "multi" covers ~10 languages but NOT
# Catalan — it returns an EMPTY transcript rather than an error. Set to "ca"
# (or "es") monolingually if the bot talks to Catalan-speaking prospects.
TELEGRAM_TRANSCRIPTION_LANGUAGE="multi"

# Where lead alerts go. Comma-separated for several recipients. Without this the
# bot delivers proposals and nobody on the team finds out. Needs RESEND_API_KEY.
TELEGRAM_LEAD_NOTIFY_EMAIL=""

# Push each lead's extracted tasks into Linear. Off by default: every curious
# stranger would otherwise land as tickets on the team's board.
TELEGRAM_SYNC_TO_LINEAR="false"

# Speech-to-text provider, backend-wide.
#   deepgram  Deepgram's cloud (default). Uses the workspace's BYOK key.
#   whisper   Self-hosted Whisper with an OpenAI-compatible API. Start it with
#             `yarn docker:whisper` (repo root) and download the model once with
#             `curl -X POST http://localhost:8010/v1/models/<WHISPER_MODEL>`.
STT_PROVIDER=deepgram
# WHISPER_BASE_URL=http://localhost:8010
# WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Smaller model for live captions on a CPU-only host (defaults to WHISPER_MODEL):
# WHISPER_LIVE_MODEL=Systran/faster-whisper-small
# Interim captions every N ms while someone talks; 0 turns them off. They stop
# on their own when the server is slower than this.
# WHISPER_LIVE_INTERIM_MS=1500
# WHISPER_API_KEY=
# Speaker separation for the system-audio channel, through the voice service
# (VOICE_AI_URL). On whenever VOICE_AI_URL is set; "false" turns it off and
# everyone else in the meeting comes out as one speaker.
# WHISPER_DIARIZE=true
# WHISPER_DIARIZE_MAX_SPEAKERS=8
# Cosine distance under which two utterances count as the same voice.
# WHISPER_DIARIZE_THRESHOLD=0.5

# ── Self-hosted AI ───────────────────────────────────────────────────────────
# For customers whose meeting text may not leave their infrastructure. Start
# the stack with `yarn docker:private` (repo root); it downloads the models on
# first start. Then switch the backend over with the block below.
#
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=gemma3:27b
# Model for high-volume chat calls (defaults to LOCAL_LLM_MODEL):
# LOCAL_LLM_FAST_MODEL=
# Must match OLLAMA_CONTEXT_LENGTH in docker-compose.yml:
# LOCAL_LLM_CONTEXT_TOKENS=32768
# LOCAL_LLM_API_KEY=
#
# Local embeddings go to their own Qdrant collection (vectors of another
# size), so documents indexed before the switch must be indexed again.
# EMBEDDINGS_PROVIDER=local
# LOCAL_EMBEDDINGS_MODEL=bge-m3
# LOCAL_EMBEDDINGS_DIMENSION=1024
#
# STT_PROVIDER=whisper
# WHISPER_BASE_URL=http://localhost:8010
# The voice service from the compose stack (speaker separation, voice profiles):
# VOICE_AI_URL=http://localhost:8002
